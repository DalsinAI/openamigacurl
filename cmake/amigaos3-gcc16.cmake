# openamigacurl: CMake cross toolchain for AmigaOS 3.x with the os32-gcc16
# stove (OpenAmigaGCC 16.2, libnix, libpthread). C only.
# MIT, Copyright (c) 2026 AmigaChrome Team.
#   OS32_GCC16      the stove root, holding prefix/ (default ~/AmigaChrome/stoves/os32-gcc16)
#   OS32_CPU_FLAGS  CPU flags (default 68040 with FPU)
if (DEFINED ENV{OS32_GCC16})
    set(AC_OS32_STOVE "$ENV{OS32_GCC16}")
else ()
    set(AC_OS32_STOVE "$ENV{HOME}/AmigaChrome/stoves/os32-gcc16")
endif ()
set(CMAKE_SYSTEM_NAME AmigaOS)
set(CMAKE_SYSTEM_PROCESSOR m68k)
set(CMAKE_C_COMPILER "${AC_OS32_STOVE}/prefix/bin/m68k-amigaos-gcc")
set(CMAKE_AR "${AC_OS32_STOVE}/prefix/bin/m68k-amigaos-ar" CACHE FILEPATH "" FORCE)
set(CMAKE_RANLIB "${AC_OS32_STOVE}/prefix/bin/m68k-amigaos-ranlib" CACHE FILEPATH "" FORCE)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
if (DEFINED ENV{OS32_CPU_FLAGS})
    set(AC_OS32_CPU_FLAGS "$ENV{OS32_CPU_FLAGS}")
else ()
    set(AC_OS32_CPU_FLAGS "-m68040 -m68881 -mcrt=nix20")
endif ()
# address 0 is memory on an Amiga: keep reads of it as reads
set(CMAKE_C_FLAGS_INIT "${AC_OS32_CPU_FLAGS} -fno-delete-null-pointer-checks -D_DEFAULT_SOURCE=1 -D_POSIX_TIMERS=1 -D_POSIX_REALTIME_SIGNALS=1")
set(CMAKE_EXE_LINKER_FLAGS_INIT "${AC_OS32_CPU_FLAGS}")
set(CMAKE_FIND_ROOT_PATH "${AC_OS32_STOVE}/prefix/m68k-amigaos")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
